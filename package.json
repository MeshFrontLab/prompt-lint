{
  "name": "@meshfrontlab/prompt-lint",
  "version": "0.1.0",
  "description": "Lint prompt, skill and agent instruction files (SKILL.md, CLAUDE.md, AGENTS.md, *.prompt.md): pasted secrets, broken {{variables}}, dead links, bloated context.",
